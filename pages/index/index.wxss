.hero {
  background: #0b7a5a;
  color: #ffffff;
  border-radius: 8rpx;
  padding: 32rpx;
  box-shadow: 0 10rpx 24rpx rgba(10, 125, 90, 0.18);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.92;
  line-height: 1.5;
}

.primary-button {
  margin-top: 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 6rpx;
  color: #0b7a5a;
  background: #ffffff;
  font-size: 28rpx;
}
